---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { title, date, description, cover, coverAlt } = post.data;
const { Content } = await render(post);
const ogImage = await getImage({ src: cover, width: 1200, format: 'jpg', quality: 70 });
---

<Base title={title} description={description} image={ogImage.src}>
  <article>
    <header class="prose head">
      <p class="eyebrow"><time datetime={date.toISOString()}>{formatDate(date)}</time></p>
      <h1>{title}</h1>
    </header>
    <div class="prose">
      <Image src={cover} alt={coverAlt} widths={[600, 1200]} width={1200} quality={70} sizes="(min-width: 38rem) 38rem, 100vw" class="photo cover" loading="eager" />
    </div>
    <div class="prose body">
      <Content />
    </div>
  </article>

  <nav class="prose pager" aria-label="More Field Notes">
    {newer ? <a href={`/blog/${newer.id}`}>← {newer.data.title}</a> : <span />}
    {older && <a href={`/blog/${older.id}`}>{older.data.title} →</a>}
  </nav>
</Base>

<style>
  .head { padding-top: 2rem; }
  .cover { margin: 1.5rem 0 2.5rem; max-height: 80vh; }
  .body :global(h2), .body :global(h3), .body :global(h4) { margin-top: 1.75em; }
  .body :global(img) { margin: 2rem 0; }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .pager a:last-child { text-align: right; }
</style>
