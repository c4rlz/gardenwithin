---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { cardImage, coverTransitionName, formatDate, getPosts } from '../../lib/posts';
import signoff from '../../assets/home-signoff.png';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { title, date, description, cover, coverAlt } = post.data;
const { Content } = await render(post);
const ogImage = await getImage({ src: cover, width: 1200, format: 'jpg', quality: 70 });

// The card's own photo files (likely already cached from the Field Notes list) show
// instantly behind the cover while the full-size cover loads and fades in on top.
const card = await getImage({ src: cover, ...cardImage });
const cardUrl = (w: string) => card.srcSet.values.find((v) => v.descriptor === w)?.url ?? card.src;
const placeholder = `image-set(url("${cardUrl('400w')}") 1x, url("${cardUrl('600w')}") 2x)`;
---

<Base title={title} description={description} image={ogImage.src}>
  <article>
    <header class="prose head">
      <p class="eyebrow"><time datetime={date.toISOString()}>{formatDate(date)}</time></p>
      <h1>{title}</h1>
    </header>
    <div class="wrap figure">
      <div class="frame" style={`view-transition-name: ${coverTransitionName(post.id)}; background-image: ${placeholder}`}>
        <Image src={cover} alt={coverAlt} widths={[800, 1600]} width={1600} quality={70} sizes="(min-width: 52rem) 52rem, 100vw" class="photo cover" loading="eager" fetchpriority="high" />
      </div>
    </div>
    <div class="prose body">
      <Content />
      <Image src={signoff} alt="Xo, C" class="signoff" />
    </div>
  </article>

  <nav class="prose pager" aria-label="More Field Notes">
    {
      newer ? (
        <a href={`/blog/${newer.id}`}>
          <span class="eyebrow">← Newer</span>
          {newer.data.title}
        </a>
      ) : <span />
    }
    {
      older && (
        <a href={`/blog/${older.id}`} class="older">
          <span class="eyebrow">Older →</span>
          {older.data.title}
        </a>
      )
    }
  </nav>
</Base>

<style>
  .head { padding-top: clamp(1rem, 3vw, 2.5rem); text-align: center; }
  .head h1 { margin-bottom: 0; }
  .figure { max-width: calc(52rem + 2 * var(--gutter)); margin: clamp(2rem, 5vw, 3.5rem) auto; }
  .frame {
    aspect-ratio: 3 / 2;
    max-height: 75vh;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface) center / cover no-repeat;
    view-transition-class: post-cover;
  }
  .cover { height: 100%; background: none; }
  .body > :global(p:first-child) { font-size: 1.12em; }
  .body :global(h2), .body :global(h3), .body :global(h4) { margin-top: 1.75em; }
  .body :global(img) { margin: 2rem 0; }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 4.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--rule);
  }
  .pager a {
    display: grid;
    gap: 0.25rem;
    max-width: 48%;
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.2;
    color: var(--text);
    text-decoration: none;
  }
  .pager a:hover { color: var(--link); }
  .pager .eyebrow { margin: 0; }
  .pager .older { text-align: right; margin-left: auto; }
</style>
