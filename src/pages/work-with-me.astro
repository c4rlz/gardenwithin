---
import Base from '../layouts/Base.astro';
import { site } from '../content/site';

const { workWithMe } = site;
const { bookingUrl } = workWithMe.call;
---

<Base title={workWithMe.title} description={workWithMe.lede}>
  <section class="prose head">
    <h1>{workWithMe.title}</h1>
    <p class="lede">{workWithMe.lede}</p>
    {workWithMe.body.map((p) => <p>{p}</p>)}
  </section>

  <section class="section wrap" id="book">
    <div class="prose call">
      <h2>{workWithMe.call.title}</h2>
      <p>{workWithMe.call.body}</p>
    </div>
    {
      bookingUrl ? (
        <iframe class="booking" src={`${bookingUrl}?embed=true&layout=month_view`} title="Book a free 15-minute call" loading="lazy" />
      ) : (
        <p class="prose">
          <a class="button" href="/contact">Get in touch to book</a>
        </p>
      )
    }
  </section>
</Base>

<style>
  .head { padding-top: clamp(1rem, 3vw, 2.5rem); }
  .call h2 { margin-top: 0; }
  .booking { display: block; width: 100%; height: 44rem; border: 0; border-radius: var(--radius); background: var(--surface); }
</style>
