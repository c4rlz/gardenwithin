---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostGrid from '../components/PostGrid.astro';
import { site } from '../content/site';
import { getPosts } from '../lib/posts';
import hero from '../assets/home-hero.jpg';
import about from '../assets/home-about.jpg';
import signoff from '../assets/home-signoff.png';

const { home } = site;
const latest = (await getPosts()).slice(0, 2);
---

<Base>
  <section class="section wrap split hero">
    <div>
      <h1>{home.title}</h1>
      <p class="lede">{home.lede}</p>
      {home.intro.map((p) => <p>{p}</p>)}
      <a class="button" href="/blog">Read the Field Notes</a>
    </div>
    <Image src={hero} alt="" widths={[600, 1200]} width={1200} quality={70} sizes="(min-width: 52rem) 50vw, 90vw" class="photo arch hero-img" loading="eager" />
  </section>

  <div class="band">
    <section class="section wrap split notes">
      <div class="notes-intro">
        <p class="eyebrow">Latest writing</p>
        <h2>{home.notes.title}</h2>
        {home.notes.body.map((p) => <p>{p}</p>)}
        <a class="button" href="/blog">All Field Notes</a>
      </div>
      <PostGrid posts={latest} />
    </section>
  </div>

  <section class="section wrap split about">
    <Image src={about} alt="" widths={[600, 1200]} width={1200} quality={70} sizes="(min-width: 52rem) 40vw, 90vw" class="photo" />
    <div>
      <h2>{home.about.title}</h2>
      {home.about.body.map((p) => <p>{p}</p>)}
      <Image src={signoff} alt="Xo, C" class="signoff" />
    </div>
  </section>
</Base>

<style>
  .split { display: grid; gap: 2.5rem 4rem; align-items: center; }
  .split h1, .split h2 { margin-top: 0; }
  .hero { padding-top: clamp(1rem, 3vw, 2.5rem); }
  .hero-img { aspect-ratio: 4 / 5; max-height: 40rem; }
  .notes-intro { max-width: 26rem; }
  @media (min-width: 52rem) {
    .hero { grid-template-columns: 1fr 1fr; }
    .notes { grid-template-columns: 2fr 3fr; }
    .about { grid-template-columns: 1fr 1fr; }
  }
</style>
