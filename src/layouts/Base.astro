---
import '@fontsource-variable/cormorant-garamond';
import '@fontsource-variable/eb-garamond';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import { site } from '../content/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = site.description, image } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.name;
// Pages build to <name>.html (see astro.config.mjs) but are served without the extension.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site);
const current = path;
const isCurrent = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f6f1e7" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      // Fade photos in as they arrive instead of letting them pop in. Without JS they show normally.
      document.documentElement.classList.add('js');
      const reveal = (img) => img.classList.add('loaded');
      document.addEventListener('load', (e) => e.target.tagName === 'IMG' && reveal(e.target), true);
      document.addEventListener('DOMContentLoaded', () => document.querySelectorAll('img').forEach((img) => img.complete && reveal(img)));
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/">{site.name}</a>
      <nav aria-label="Main">
        <ul>
          {
            site.nav.map(({ href, label }) => (
              <li>
                <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p class="footer-brand">{site.name}</p>
      <p class="footer-links">
        <a href={site.instagram}>Instagram</a>
        <a href="/contact">Contact</a>
      </p>
      <p class="copyright">© {new Date().getFullYear()} {site.name}</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    padding: clamp(1.75rem, 4vw, 2.75rem) var(--gutter) clamp(1.5rem, 3vw, 2.25rem);
    text-align: center;
    view-transition-name: site-header; /* stays put while the page crossfades */
  }
  .brand {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 2vw + 1rem, 2.4rem);
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--text);
    text-decoration: none;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem clamp(1rem, 3vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-family: var(--font-sans);
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  nav a:hover { color: var(--text); }
  nav a[aria-current='page'] { color: var(--text); border-bottom-color: var(--terracotta); }

  .site-footer {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding: clamp(3rem, 6vw, 4.5rem) var(--gutter);
    background: var(--sage);
    color: var(--cream);
    text-align: center;
  }
  .site-footer p { margin: 0; }
  .footer-brand { font-family: var(--font-display); font-size: 1.75rem; }
  .footer-links {
    display: flex;
    gap: 1.75rem;
    font-family: var(--font-sans);
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .site-footer a { color: inherit; text-decoration: none; opacity: 0.85; }
  .site-footer a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 0.4em; }
  .copyright { margin-top: 1rem !important; font-size: 0.85rem; opacity: 0.7; }
</style>
